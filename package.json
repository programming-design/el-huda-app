{
  "name": "el-huda-app",
  "version": "1.0.0",
  "private": true,
  "description": "الهُدى — تطبيق أندرويد (Capacitor)",
  "scripts": {
    "vendor": "node scripts/vendor.js",
    "assets": "capacitor-assets generate --android",
    "add:android": "cap add android",
    "sync": "cap sync android",
    "apk": "cd android && ./gradlew assembleDebug",
    "apk:release": "cd android && ./gradlew assembleRelease",
    "aab": "cd android && ./gradlew bundleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^6.1.2",
    "@capacitor/browser": "^6.0.2",
    "@capacitor/core": "^6.1.2",
    "@capacitor/splash-screen": "^6.0.2",
    "@capacitor/status-bar": "^6.0.2"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^6.1.2"
  }
}
